# Settings for `docker compose --profile app up` — copy to .env (same folder) and fill in. Never commit .env.

# --- Real email delivery (sign-in codes to your Gmail inbox) ---------------------------------
# Without these, every email is caught by Mailpit: https://mail.vivustay.localhost
# Gmail: Google Account → Security → 2-Step Verification ON → App passwords → create one for "Mail".
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=phtuancntt@gmail.com
MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_FROM_ADDRESS=phtuancntt@gmail.com

# --- "Sign in with Google" on the Web Admin (optional) ----------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: https://admin.vivustay.localhost/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
